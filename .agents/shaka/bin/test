#!/usr/bin/env bash
# Run the repository's CI-backed automated verification gate.
#
# This project has no separate unit or end-to-end test suite. A full Astro build
# validates the content collections and renders every static route, which is the
# verification GitHub Actions runs for pull requests.
set -euo pipefail
root=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_CEILING_DIRECTORIES git -C "$(dirname -- "$0")" rev-parse --show-toplevel) || exit $?
cd "$root"
exec "$root/.agents/bin/build"
