#!/usr/bin/env bash
# Install dependencies with the Yarn v1 contract pinned in package.json.
set -euo pipefail
root=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_CEILING_DIRECTORIES git -C "$(dirname -- "$0")" rev-parse --show-toplevel) || exit $?
cd "$root"
exec corepack yarn install --frozen-lockfile
